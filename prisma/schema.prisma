// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  APPROVER
  PURCHASING
  ADMIN
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  NEED_REVISION
  NEED_CLARIFICATION
  REJECTED
  ORDERED
  COMPLETED
  CANCEL_REQUESTED
  CANCELLED
}

enum ApprovalAction {
  DRAFT_SAVED
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  REQUESTED_REVISION
  REQUESTED_CLARIFICATION
  ORDERED
  COMPLETED
  COMMENTED
  CANCELLATION_REQUESTED
  CANCELLATION_DECLINED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationEmailStatus {
  DISABLED
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ReceiptAction {
  RECEIVED
  CLOSE_REMAINDER
}

enum SupplierContactChannel {
  LINE
  PHONE
  ECOMMERCE
  EMAIL
  OTHER
}

enum PurchasePriceTaxMode {
  UNSPECIFIED
  INCLUSIVE
  EXCLUSIVE
  NONE
}

enum PurchaseDiscountType {
  NONE
  AMOUNT
  PERCENT
}

enum PurchaseOrderChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  ISSUED
  CANCELLED
}

model User {
  id                            String                      @id @default(cuid())
  employeeCode                  String                      @unique
  name                          String
  username                      String?                     @unique
  phone                         String?                     @unique
  email                         String                      @unique
  passwordHash                  String
  isActive                      Boolean                     @default(true)
  department                    String
  role                          Role
  title                         String?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  purchaseRequests              PurchaseRequest[]           @relation("RequesterPurchaseRequests")
  approvals                     Approval[]
  notifications                 Notification[]
  assignedRequests              PurchaseRequest[]           @relation("CurrentApproverPurchaseRequests")
  cancelledPurchaseRequests     PurchaseRequest[]           @relation("CancelledPurchaseRequests")
  uploadedAttachments           PurchaseRequestAttachment[] @relation("UploadedPurchaseRequestAttachments")
  recordedReceipts              PurchaseRequestReceipt[]
  createdPurchaseOrders         PurchaseOrder[]
  deliveryPurchaseOrders        PurchaseOrder[]             @relation("PurchaseOrderDeliveryRecipient")
  cancelledPurchaseOrders       PurchaseOrder[]             @relation("CancelledPurchaseOrders")
  submittedPurchaseOrderChanges PurchaseOrderChange[]       @relation("SubmittedPurchaseOrderChanges")
  reviewedPurchaseOrderChanges  PurchaseOrderChange[]       @relation("ReviewedPurchaseOrderChanges")
  createdPurchaseOrderShares    PurchaseOrderShare[]        @relation("CreatedPurchaseOrderShares")
  revokedPurchaseOrderShares    PurchaseOrderShare[]        @relation("RevokedPurchaseOrderShares")
}

model PurchaseRequest {
  id                      String                      @id @default(cuid())
  prNumber                String                      @unique
  requestDate             DateTime                    @default(now())
  requesterId             String
  requester               User                        @relation("RequesterPurchaseRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  currentApproverId       String?
  currentApprover         User?                       @relation("CurrentApproverPurchaseRequests", fields: [currentApproverId], references: [id], onDelete: SetNull)
  cancelledById           String?
  cancelledBy             User?                       @relation("CancelledPurchaseRequests", fields: [cancelledById], references: [id], onDelete: SetNull)
  department              String
  reason                  String
  urgency                 Priority                    @default(NORMAL)
  status                  PurchaseRequestStatus       @default(DRAFT)
  totalAmount             Decimal                     @db.Decimal(12, 2)
  submittedAt             DateTime?
  approvedAt              DateTime?
  orderedAt               DateTime?
  receivedAt              DateTime?
  completedAt             DateTime?
  cancellationRequestedAt DateTime?
  cancelledAt             DateTime?
  cancellationReason      String?
  cancellationReference   String?
  receiptNumber           String?
  taxInvoiceNumber        String?
  receiptReferenceNote    String?
  receiptVersion          Int                         @default(0)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  items                   PurchaseRequestItem[]
  approvals               Approval[]
  attachments             PurchaseRequestAttachment[]
  receipts                PurchaseRequestReceipt[]
  primaryPurchaseOrders   PurchaseOrder[]                  @relation("PrimaryPurchaseRequest")
  purchaseOrders          PurchaseOrder[]                  @relation("PurchaseOrderSources")
  sourcedPurchaseOrderItems PurchaseOrderItem[]

  @@index([requesterId, status])
  @@index([department, status])
  @@index([requestDate])
  @@index([cancelledById])
}

model PurchaseRequestAttachment {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  uploadedById      String
  uploadedBy        User            @relation("UploadedPurchaseRequestAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)
  originalName      String
  storedName        String
  mimeType          String
  size              Int
  storagePath       String
  createdAt         DateTime        @default(now())

  @@index([purchaseRequestId, createdAt])
  @@index([uploadedById])
}

model PurchaseRequestItem {
  id                String                       @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest              @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  itemName          String
  description       String?
  supplierName      String?
  quantity          Int
  receivedQuantity  Int                          @default(0)
  closedQuantity    Int                          @default(0)
  unit              String?
  unitPrice         Decimal?                     @db.Decimal(12, 2)
  amount            Decimal                      @db.Decimal(12, 2)
  taxMode           PurchasePriceTaxMode         @default(UNSPECIFIED)
  vatRate           Decimal                      @default(7) @db.Decimal(5, 2)
  discountType      PurchaseDiscountType         @default(NONE)
  discountValue     Decimal                      @default(0) @db.Decimal(12, 2)
  orderDiscountAmount Decimal                    @default(0) @db.Decimal(12, 2)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  receiptItems      PurchaseRequestReceiptItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([purchaseRequestId])
}

model PurchaseRequestReceipt {
  id                String                       @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest              @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  recordedById      String
  recordedBy        User                         @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  action            ReceiptAction
  receivedDate      DateTime
  comment           String?
  overReceiptReason String?
  receiptNumber     String?
  taxInvoiceNumber  String?
  createdAt         DateTime                     @default(now())
  items             PurchaseRequestReceiptItem[]

  @@index([purchaseRequestId, createdAt])
}

model PurchaseRequestReceiptItem {
  id        String                 @id @default(cuid())
  receiptId String
  receipt   PurchaseRequestReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId    String?
  item      PurchaseRequestItem?   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  purchaseOrderItemId String?
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  quantity  Int

  @@unique([receiptId, itemId])
  @@unique([receiptId, purchaseOrderItemId])
  @@index([itemId])
  @@index([purchaseOrderItemId])
}

model PurchaseOrder {
  id                    String                @id @default(cuid())
  poNumber              String                @unique
  purchaseRequestId     String
  purchaseRequest       PurchaseRequest       @relation("PrimaryPurchaseRequest", fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  purchaseRequests      PurchaseRequest[]     @relation("PurchaseOrderSources")
  createdById           String
  createdBy             User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  issuedAt              DateTime              @default(now())
  status                PurchaseOrderStatus   @default(ISSUED)
  cancelledAt           DateTime?
  cancelledById         String?
  cancelledBy           User?                 @relation("CancelledPurchaseOrders", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancellationReason    String?
  cancellationReference String?
  buyerCompany          Json?
  supplierName          String
  supplierId            String?
  supplier              Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierCode          String?
  supplierTaxId         String?
  supplierContactPerson String?
  supplierContacts      Json?
  supplierAddress       String?
  supplierContact       String?
  deliveryAddress       String?
  deliveryRecipientId    String?
  deliveryRecipient     User?                 @relation("PurchaseOrderDeliveryRecipient", fields: [deliveryRecipientId], references: [id], onDelete: SetNull)
  deliveryRecipientName String?
  deliveryRecipientPhone String?
  paymentTerms          String?
  expectedDeliveryDate  DateTime?
  note                  String?
  totalAmount           Decimal               @db.Decimal(12, 2)
  taxMode               PurchasePriceTaxMode  @default(UNSPECIFIED)
  vatRate               Decimal               @default(7) @db.Decimal(5, 2)
  discountType          PurchaseDiscountType  @default(NONE)
  discountValue         Decimal               @default(0) @db.Decimal(12, 2)
  version               Int                   @default(0)
  revision              Int                   @default(0)
  createdAt             DateTime              @default(now())
  items                 PurchaseOrderItem[]
  changes               PurchaseOrderChange[]
  share                 PurchaseOrderShare?

  @@index([purchaseRequestId, issuedAt])
  @@index([createdById])
  @@index([supplierId])
  @@index([deliveryRecipientId])
  @@index([status, issuedAt])
  @@index([cancelledById])
}

model PurchaseOrderShare {
  id              String        @id @default(cuid())
  purchaseOrderId String        @unique
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  token           String        @unique
  supplierKey     String
  createdById     String
  createdBy       User          @relation("CreatedPurchaseOrderShares", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedById     String?
  revokedBy       User?         @relation("RevokedPurchaseOrderShares", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([revokedById])
}

model PurchaseOrderChange {
  id              String                    @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder             @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  submittedById   String
  submittedBy     User                      @relation("SubmittedPurchaseOrderChanges", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedById    String?
  reviewedBy      User?                     @relation("ReviewedPurchaseOrderChanges", fields: [reviewedById], references: [id], onDelete: Restrict)
  reason          String
  reviewComment   String?
  status          PurchaseOrderChangeStatus @default(PENDING)
  baseVersion     Int
  before          Json
  after           Json
  createdAt       DateTime                  @default(now())
  reviewedAt      DateTime?

  @@index([purchaseOrderId, createdAt])
  @@index([purchaseOrderId, status])
  @@index([submittedById])
  @@index([reviewedById])
}

model Supplier {
  id             String            @id @default(cuid())
  code           Int               @unique @default(autoincrement())
  name           String
  taxId          String?
  address        String?
  contactPerson  String?
  paymentTerms   String?
  note           String?
  isActive       Boolean           @default(true)
  version        Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  contacts       SupplierContact[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive, name])
}

model SupplierContact {
  id         String                 @id @default(cuid())
  supplierId String
  supplier   Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  channel    SupplierContactChannel
  value      String

  @@unique([supplierId, channel])
}

model PurchaseOrderItem {
  id                    String              @id @default(cuid())
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sourcePurchaseRequestId String
  sourcePurchaseRequest PurchaseRequest     @relation(fields: [sourcePurchaseRequestId], references: [id], onDelete: Restrict)
  purchaseRequestItemId String?
  purchaseRequestItem   PurchaseRequestItem? @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Restrict)
  position              Int
  itemName              String
  description           String?
  quantity              Int
  receivedQuantity      Int                 @default(0)
  closedQuantity        Int                 @default(0)
  unit                  String?
  unitPrice             Decimal             @db.Decimal(12, 2)
  amount                Decimal             @db.Decimal(12, 2)
  taxMode               PurchasePriceTaxMode?
  discountType          PurchaseDiscountType  @default(NONE)
  discountValue         Decimal               @default(0) @db.Decimal(12, 2)
  orderDiscountAmount   Decimal               @default(0) @db.Decimal(12, 2)
  receiptItems          PurchaseRequestReceiptItem[]

  @@unique([purchaseOrderId, position])
  @@index([purchaseRequestItemId])
  @@index([sourcePurchaseRequestId, purchaseOrderId])
}

model PurchaseOrderNumberSequence {
  key       String @id
  nextValue Int    @default(1)
}

model CompanyProfile {
  id        String   @id @default("default")
  name      String
  address   String
  taxId     String?
  branch    String?
  phone     String?
  email     String?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Approval {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  approverId        String
  approver          User            @relation(fields: [approverId], references: [id], onDelete: Cascade)
  action            ApprovalAction
  stepLabel         String?
  comment           String?
  createdAt         DateTime        @default(now())

  @@index([purchaseRequestId, createdAt])
}

model Notification {
  id             String                  @id @default(cuid())
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  link           String?
  type           NotificationType        @default(INFO)
  emailStatus    NotificationEmailStatus @default(PENDING)
  emailSentAt    DateTime?
  emailError     String?
  emailMessageId String?
  readAt         DateTime?
  createdAt      DateTime                @default(now())

  @@index([userId, createdAt])
}
